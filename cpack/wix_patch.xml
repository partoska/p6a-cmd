  Adds the bin directory of the MSI installation to the system PATH (the
  NSIS installer asks instead); CM_CP_bin.p6a.exe is the component CPack
  generates for bin/p6a.exe.
-->
<CPackWiXPatch>
  <CPackWiXFragment Id="CM_CP_bin.p6a.exe">
    <Environment Id="P6aPath" Name="PATH" Value="[INSTALL_ROOT]bin" Action="set" Part="last" Permanent="no" System="yes"/>
  </CPackWiXFragment>
</CPackWiXPatch>
